# Copy to .env and fill in locally. Never commit the filled file.
# Use single quotes around values containing $, # or spaces.
ADMIN_USERNAME=
# At least 12 characters. This minimal version uses a password from environment.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000

# Local Node and Python default to ./data. Compose always sets /app/data.
DATA_DIR=./data
# Compose mounts this non-secret provider config read-only; no Windows paths inside it.
MODEL_CONFIG_FILE=./config.json

LLM_API_KEY=
EMBEDDING_API_KEY=
# For local runs only. Compose uses the mounted /app/runtime-config.json.
# INTERVIEW_CONFIG=config.local.json
